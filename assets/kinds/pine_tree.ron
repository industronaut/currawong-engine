// Pine — taller and narrower than oak, slower to chop. Demonstrates the
// per-species data + asset binding (different glTF, different texture,
// different stats — all under one shared "tree" render shape).
(
    id: "currawong:pine_tree",
    chop_ticks: 120,
    render: (
        shape: "tree",
        mesh: "models/trees/pine.glb",
        albedo: "textures/trees/pine_bark.png",
        metallic: 0.0,
        roughness: 0.95,
        bounds_min: (-0.50, -0.50, 0.0),
        bounds_max: (0.50, 0.50, 2.70),
    ),
)
