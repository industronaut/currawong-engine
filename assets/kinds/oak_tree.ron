// Oak — the workhorse tree species for the lumber camp example.
// Sim consumes `chop_ticks`; view consumes `render`.
(
    id: "currawong:oak_tree",
    chop_ticks: 90,
    // Any of the 8 surrounding tiles is a valid chop spot. Rotation-
    // invariant (trees don't have a meaningful facing).
    interaction: (type: "Surround", radius_tiles: 1),
    render: (
        shape: "tree",
        mesh: "models/trees/oak.glb",
        albedo: "textures/trees/oak_bark.png",
        metallic: 0.0,
        roughness: 0.95,
        // World-space AABB the visual occupies (after origin-at-base
        // placement). Drives the frustum cull + the asset server's
        // magenta fallback sizing while the real mesh streams in.
        bounds_min: (-0.65, -0.65, 0.0),
        bounds_max: (0.65, 0.65, 2.10),
    ),
)
